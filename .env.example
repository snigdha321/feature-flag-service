# Application
APP_NAME=feature-flag-service
ENV=local
LOG_LEVEL=INFO
LOG_JSON=true

# Database
# Local (docker-compose):
DATABASE_URL=postgresql+asyncpg://flags:flags@localhost:5432/flags
# Managed provider (e.g. DigitalOcean) - the plain postgresql:// scheme and
# ?sslmode=require are normalized automatically to asyncpg + an SSL context:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/defaultdb?sslmode=require

# Cache
CACHE_TTL_SECONDS=30

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME=feature-flag-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
